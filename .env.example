# BangSayur — contoh environment. SALIN ke .env lalu isi secret.
# JANGAN commit .env yang sudah terisi.
#
# Switch Core (PostgreSQL)
DB_NAME=switch
DB_USER=switch_app
DB_PASSWORD=ganti-password-switch-app
DB_OWNER=postgres
DB_OWNER_PASSWORD=ganti-password-owner
GATEWAY_ADMIN_EMAIL=admin@switch.local
GATEWAY_ADMIN_PASSWORD=ganti-password-admin
AGENT_REGISTRATION_TOKEN=isi-dari-generate-env-secrets
#
# Mattermost
MM_PASSWORD=ganti-password-mmuser
MATTERMOST_ADMIN_USER=pemilik
MATTERMOST_ADMIN_PASSWORD=ganti-password-pemilik
MATTERMOST_TEAM_NAME=komplek-melati
MATTERMOST_USER=warga
MATTERMOST_USER_PASSWORD=ganti-password-warga
#
# Agen BangSayur (jangan tulis key Baseten di sini — pakai Secure Vault
# atau export BASENTEN_API_KEY saat menjalankan agent/run.py)
BASENTEN_API_KEY=
